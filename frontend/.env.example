# Base URL of the SkillTrace backend API.
# Leave unset to use http://127.0.0.1:8000 (the default). Use the IP rather
# than "localhost": on macOS that name resolves to IPv6 first, and not every
# browser falls back to IPv4 when the backend only listens there.
VITE_API_BASE=http://127.0.0.1:8000

# Endpoint used by the Employer Confirmation page.
# Swap to /employer-confirm once the backend team confirms a dedicated route.
VITE_EMPLOYER_CONFIRM_PATH=/checkin

# Set to "1" to skip live API calls entirely and always use the local mock store.
VITE_FORCE_MOCK=0

# ---- AI assistant ----
# Helpline quoted when the assistant cannot answer from the data it holds.
VITE_MOCK_HELPLINE_NUMBER=1800-XXX-XXXX

# Which engine answers questions. "internal" is the built-in deterministic
# engine and needs no credentials — it is the default, and the only mode the
# demo requires. "gemini" or "openai" additionally need the two values below.
VITE_AI_PROVIDER=internal
VITE_AI_API_URL=
VITE_AI_API_KEY=

# ---- Google sign-in ----
# Nothing is needed here. The OAuth client id and secret live in backend/.env
# and never reach the browser; the frontend only redirects to the backend.
