# Base URL of the SkillTrace backend API.
# Leave unset to use http://localhost:8000 (the default).
VITE_API_BASE=http://localhost:8000

# Endpoint used by the Employer Confirmation page.
# Swap to /employer-confirm once the backend team confirms a dedicated route.
VITE_EMPLOYER_CONFIRM_PATH=/checkin

# Set to "1" to skip live API calls entirely and always use the local mock store.
VITE_FORCE_MOCK=0

# AI Chatbot Configuration
# Temporary mock helpline for human support fallback (configurable)
VITE_MOCK_HELPLINE_NUMBER=1800-XXX-XXXX

# Optional external AI endpoint (defaults to built-in factual NLP engine)
# Set to 'gemini' or 'openai' or 'internal'
VITE_AI_PROVIDER=internal
VITE_AI_API_URL=
VITE_AI_API_KEY=
